{{- define "field_unmarshal_i64" -}}
    {{- $c := . -}}
    {{- with .field -}}
        {{- /*gotype: github.com/e-tape/litepb/proto.Message_Field*/ -}}
        {{ if eq .GetType.GetInProto.String "FIXED64" -}}
            {{ if not $c.packed -}}
                {{ template "field_unmarshal_fixed64" $c }}
            {{ else -}}
                {{ template "field_unmarshal_fixed64_packed" $c -}}
            {{ end -}}
        {{ else if eq .GetType.GetInProto.String "SFIXED64" -}}
            {{ if not $c.packed -}}
                {{ template "field_unmarshal_sfixed64" $c }}
            {{ else -}}
                {{ template "field_unmarshal_sfixed64_packed" $c -}}
            {{ end -}}
        {{ else if eq .GetType.GetInProto.String "DOUBLE" -}}
            {{ if not $c.packed -}}
                {{ template "field_unmarshal_double" $c }}
            {{ else -}}
                {{ template "field_unmarshal_double_packed" $c -}}
            {{ end -}}
        {{ end -}}
    {{- end -}}
{{- end -}}